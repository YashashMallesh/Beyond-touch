---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const sections = [
  { title: 'Getting Started', description: 'Overview and setup instructions.', href: `${base}/overview` },
  { title: 'Requirements', description: 'What things are required and API Reference.', href: `${base}/R` },
  { title: 'Installation', description: 'Packages and more.', href: `${base}/I` },
  { title: 'Gesture Reference', description: 'Guide for gestures.', href: `${base}/GR` },
  { title: 'How it works', description: 'Architecture and workflow.', href: `${base}/workflow` },
  { title: 'Safety and reliability', description: 'Measures taken to avoid accidental gestures.', href: `${base}/SR` },
  { title: 'Contributors', description: 'People who worked on this project.', href: 'https://github.com/navaminagaraja23-ops/gesture-presenter#contributors' },
  { title: 'Credits', description: 'Package and module providers.', href: `${base}/credits` }
];
---

<Layout title="Docs — My Projects">
  <h1>Documentation</h1>
  <p class="subtitle">Everything you need to know about the project.</p>

  <div class="doc-grid">
    {sections.map((section) => (
      <a href={section.href} class="doc-card">
        <h2>{section.title}</h2>
        <p>{section.description}</p>
      </a>
    ))}
  </div>
</Layout>

<style>
  h1 {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .subtitle {
    color: var(--text-muted);
    margin-bottom: 40px;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .doc-card {
    display: block;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .doc-card:hover {
    border-color: var(--link);
    box-shadow: 0 1px 6px rgba(26, 115, 232, 0.08);
  }

  .doc-card h2 {
    font-size: 18px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 8px;
  }

  .doc-card p {
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
